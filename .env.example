# Copy to `.env` and fill in. `.env` is gitignored — never commit a key.

# Required for the discovery run only. Deterministic replay never reads this.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
HANDSPAN_MODEL=claude-opus-5
HANDSPAN_EFFORT=high
TARGET_APP_PORT=4300
OPERATOR_PORT=4400
CATALOG_PORT=4500

# Demo credentials for the local target app. These are fake and local-only.
# In production these would come from a secrets manager and are marked
# `sensitivity: secret` in policy.yaml so they never reach the model or the logs.
DEMO_USERNAME=teller01
DEMO_PASSWORD=demo-pass-1234

# Supplies a `secret`-classified capability input without putting it on a
# command line, where it would land in shell history and in `ps` output.
# Only inputs the artifact classifies `secret` may be read from the
# environment: every other parameter is the meaning of the call, and defaulting
# a member id from a stray environment variable would be a dangerous
# convenience. An explicit --input always wins.
HANDSPAN_INPUT_PASSWORD=demo-pass-1234

# Required only for an identity-linked API key (one issued against a person
# rather than a bare organisation key). Such a key is rejected with a 400
# unless every request names the workspace it acts in. Find it in the
# Anthropic Console under Settings -> Workspaces; it looks like wrkspc_...
ANTHROPIC_WORKSPACE_ID=

# MERIDIAN CORE's capability names the field `operatorPassword`, and the env
# convention is camelCase -> SNAKE_CASE. Public demo credential from the brief.
HANDSPAN_INPUT_OPERATOR_PASSWORD=password

# Inputs the deployment supplies rather than the caller. The operator identity
# is bound here so a chatbot cannot ask to act as a supervisor.
HANDSPAN_BOUND_INPUTS=operatorId
HANDSPAN_INPUT_OPERATOR_ID=teller1
