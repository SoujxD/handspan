      "required": true,
      "sensitivity": "internal",
      "example": "teller01"
    },
    {
      "name": "password",
      "type": "string",
      "description": "Password for the operator user ID.",
      "required": true,
      "sensitivity": "secret"
    },
    {
      "name": "memberId",
      "type": "string",
      "description": "Member number to look up in the Member Search panel.",
      "required": true,
      "sensitivity": "pii",
      "example": "12345"
    }
  ],
  "outputs": [
