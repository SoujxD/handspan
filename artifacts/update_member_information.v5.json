{
  "schemaVersion": "1.0.0",
  "id": "update_member_information",
  "version": 5,
  "name": "Update Member Contact Information",
  "description": "Signs on to the Meridian Core servicing console as an operator, looks up a member by member number, opens the Update Member Information action, sets the e-mail, phone and mailing address, and saves. Returns the confirmation that the member's contact information was updated (with timestamp). Reports \"no member records matched\" and e-mail format validation as business outcomes.",
  "surface": {
    "kind": "legacy_web",
    "product": "cornerstone-meridian-core",
    "productVersion": "4.2.1",
    "recordedOnTenant": "meridian-demo",
    "entryUrl": "{{baseUrl}}/signon"
  },
  "inputs": [
    {
      "name": "operatorId",
      "type": "string",
      "description": "Operator ID used to sign on to the console.",
      "required": true,
      "sensitivity": "internal",
      "example": "teller1"
    },
    {
      "name": "operatorPassword",
      "type": "string",
      "description": "Password for the operator ID.",
      "required": true,
      "sensitivity": "secret"
    },
    {
      "name": "memberNumber",
      "type": "string",
      "description": "Member number to service.",
      "required": true,
      "sensitivity": "internal",
      "example": "102777"
    },
    {
      "name": "email",
      "type": "string",
      "description": "New e-mail address for the member; must be a valid e-mail format.",
      "required": true,
      "sensitivity": "pii",
      "example": "member102777@example.com"
    },
    {
      "name": "phone",
      "type": "string",
      "description": "New phone number for the member.",
      "required": true,
      "sensitivity": "pii",
      "example": "555-0102"
    },
    {
      "name": "mailingAddress",
      "type": "string",
      "description": "New mailing address for the member.",
      "required": true,
      "sensitivity": "pii",
      "example": "12 Example St, Springfield"
    }
  ],
  "outputs": [
    {
      "name": "confirmationMessage",
      "type": "string",
      "description": "The confirmation sentence including the effective date/time of the update.",
      "sensitivity": "internal",
      "extraction": {
        "via": "regexOnPageText",
        "pattern": "(Member\\s+\\d+\\s+contact information has been updated as of [^.]+)",
        "group": 1
      },
      "transform": "trim",
      "required": true
    },
    {
      "name": "updatedAt",
      "type": "string",
      "description": "Date and time the update was recorded.",
      "sensitivity": "internal",
      "extraction": {
        "via": "regexOnPageText",
        "pattern": "has been updated as of ([0-9/]+ [0-9:]+)",
        "group": 1
      },
      "transform": "trim",
      "required": true
    }
  ],
