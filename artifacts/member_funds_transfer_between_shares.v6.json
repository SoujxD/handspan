      "name": "sourceNewBalance",
      "type": "money",
      "description": "New balance of the source share after posting (first '(new balance)' line).",
      "sensitivity": "pii",
      "extraction": {
        "via": "regexOnPageText",
        "pattern": "\\$([0-9,]+\\.[0-9]{2}) \\(new balance\\)",
        "group": 1
      },
      "transform": "stripCurrency",
      "required": true
    },
    {
      "name": "destinationNewBalance",
      "type": "money",
      "description": "New balance of the destination share after posting (second '(new balance)' line).",
      "sensitivity": "pii",
      "extraction": {
        "via": "regexOnPageText",
        "pattern": "\\(new balance\\)[\\s\\S]*?\\$([0-9,]+\\.[0-9]{2}) \\(new balance\\)",
        "group": 1
      },
      "transform": "stripCurrency",
      "required": true
    }
