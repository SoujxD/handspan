      "description": "Date and time the transfer posted.",
      "sensitivity": "internal",
      "extraction": {
        "via": "fromLabelledCell",
        "label": "Posted:",
        "labelMatch": "normalized",
        "framePath": [],
        "direction": "right"
      },
      "transform": "trim",
      "required": true
    },
    {
      "name": "amountPosted",
      "type": "money",
      "description": "Amount actually posted, as shown on the Transfer Posted screen.",
      "sensitivity": "internal",
      "extraction": {
        "via": "fromLabelledCell",
        "label": "Amount:",
        "labelMatch": "normalized",
        "framePath": [],
        "direction": "right"
