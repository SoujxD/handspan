{
  "schemaVersion": "1.0.0",
  "id": "member_funds_transfer_between_shares",
  "version": 6,
  "name": "Member Funds Transfer Between Own Shares",
  "description": "Signs on to the Meridian Core servicing console as an operator, looks up a member by member number, opens Funds Transfer for that member, and posts a transfer of a given amount from one of the member's shares to another of the member's own shares. Returns the confirmation number, posted timestamp, amount posted and the new balances of the source and destination shares. Reports legitimate non-posting outcomes such as member not found, source share on hold, insufficient balance, invalid amount, or same source and destination share.",
  "surface": {
    "kind": "legacy_web",
    "product": "cornerstone-meridian-core",
    "productVersion": "4.2.1",
    "recordedOnTenant": "meridian-demo",
    "entryUrl": "{{baseUrl}}/signon"
  },
  "inputs": [
    {
      "name": "operatorId",
      "type": "string",
      "description": "Operator ID used to sign on to the console.",
      "required": true,
      "sensitivity": "internal",
      "example": "teller1"
    },
    {
      "name": "operatorPassword",
      "type": "string",
      "description": "Password for the operator sign-on.",
      "required": true,
      "sensitivity": "secret"
    },
    {
      "name": "memberNumber",
      "type": "string",
      "description": "Member number to search for in the Member Inquiry / Selection screen.",
      "required": true,
      "sensitivity": "pii",
      "example": "100234"
    },
    {
      "name": "fromShareOption",
      "type": "string",
      "description": "Share id to debit, exactly as it appears in the Share ID column of the member's SHARES / BALANCES grid (for example 100234-S0001-6). Not the dropdown text: the visible option label embeds a balance that changes between runs. Must be a share whose status is OPEN; a HOLD share cannot be debited.",
      "required": true,
      "sensitivity": "pii",
      "example": "100234-S0001-6"
    },
    {
      "name": "toShareOption",
      "type": "string",
      "description": "Share id to credit, exactly as it appears in the Share ID column of the member's SHARES / BALANCES grid (for example 100234-MMKT-11). Not the dropdown text: the visible option label embeds a balance that changes between runs.",
      "required": true,
      "sensitivity": "pii",
      "example": "100234-MMKT-11"
    },
    {
      "name": "amount",
      "type": "money",
      "description": "Dollar amount to transfer, as a plain figure such as 25.00 (no currency symbol).",
      "required": true,
      "sensitivity": "internal",
      "example": "25.00"
    },
    {
      "name": "memo",
      "type": "string",
      "description": "Memo text recorded with the transfer.",
      "required": false,
      "sensitivity": "internal",
      "example": "Member requested share to share transfer"
    }
  ],
  "outputs": [
    {
      "name": "confirmationNumber",
      "type": "string",
      "description": "Confirmation number issued for the posted transfer.",
      "sensitivity": "internal",
      "extraction": {
        "via": "fromLabelledCell",
        "label": "Confirmation:",
        "labelMatch": "normalized",
        "framePath": [],
        "direction": "right"
      },
      "transform": "trim",
      "required": true
    },
    {
      "name": "postedAt",
