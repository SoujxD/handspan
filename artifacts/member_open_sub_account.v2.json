      "name": "userId",
      "type": "string",
      "description": "Operator user ID for the servicing console.",
      "required": true,
      "sensitivity": "internal",
      "example": "teller01"
    },
    {
      "name": "password",
      "type": "string",
      "description": "Password for the operator user ID.",
      "required": true,
      "sensitivity": "secret"
    },
    {
      "name": "memberId",
      "type": "string",
      "description": "Member ID to look up in the Member Search panel.",
      "required": true,
      "sensitivity": "internal",
      "example": "12345"
    },
    {
      "name": "accountType",
      "type": "enum",
      "description": "Account type for the new sub-account, as shown in the Account Type dropdown.",
      "required": true,
      "sensitivity": "public",
