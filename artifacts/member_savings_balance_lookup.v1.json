{
  "schemaVersion": "1.0.0",
  "id": "member_savings_balance_lookup",
  "version": 1,
  "name": "Member SAVINGS Balance Lookup",
  "description": "Signs in to the Meridian Core Servicing console for the institution, searches Member Servicing for a given member number, and returns the member's name, status, and the current balance of their SAVINGS share account (plus the savings account number). If no member record exists for the number supplied, returns the business outcome member_not_found instead.",
  "surface": {
    "kind": "legacy_web",
    "product": "meridian-core",
    "productVersion": "8.4",
    "recordedOnTenant": "northstar",
    "entryUrl": "{{baseUrl}}/login"
  },
  "inputs": [
    {
      "name": "userId",
      "type": "string",
      "description": "Servicing console user ID for the teller/service account.",
      "required": true,
      "sensitivity": "internal",
      "example": "teller01"
    },
    {
      "name": "password",
      "type": "string",
      "description": "Password for the servicing console user.",
      "required": true,
      "sensitivity": "secret"
    },
    {
      "name": "memberId",
      "type": "string",
      "description": "Member number to look up in the Member Search panel.",
      "required": true,
      "sensitivity": "pii",
      "example": "12345"
    }
  ],
  "outputs": [
    {
      "name": "savingsCurrentBalance",
      "type": "money",
      "description": "Current balance of the member's SAVINGS share account.",
      "sensitivity": "internal",
      "extraction": {
        "via": "fromTableCell",
        "rowMatch": "SAVINGS",
        "columnLabel": "Current Balance",
        "matchMode": "contains",
        "framePath": []
      },
      "transform": "stripCurrency",
      "required": true
    },
    {
      "name": "savingsAccountNumber",
      "type": "string",
      "description": "Account number of the SAVINGS share account.",
      "sensitivity": "internal",
      "extraction": {
        "via": "fromTableCell",
        "rowMatch": "SAVINGS",
        "columnLabel": "Account",
        "matchMode": "contains",
        "framePath": []
      },
      "transform": "trim",
      "required": true
    },
    {
      "name": "memberName",
      "type": "string",
      "description": "Member name as shown on the Member Record panel.",
      "sensitivity": "pii",
      "extraction": {
        "via": "fromLabelledCell",
        "label": "Member Name",
        "labelMatch": "normalized",
        "framePath": [],
        "direction": "right"
      },
      "transform": "trim",
      "required": true
    },
    {
      "name": "memberStatus",
      "type": "string",
      "description": "Membership status, e.g. ACTIVE.",
      "sensitivity": "internal",
      "extraction": {
        "via": "fromLabelledCell",
        "label": "Status",
        "labelMatch": "normalized",
        "framePath": [],
        "direction": "right"
      },
      "transform": "trim",
      "required": true
    }
  ],
