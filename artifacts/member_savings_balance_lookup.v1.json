      "code": "no_savings_account",
      "title": "Member record has no SAVINGS share account",
      "classification": "business",
      "detect": {
        "kind": "regexPresent",
        "pattern": "Share Accounts(?![\\s\\S]*SAVINGS)"
      },
      "scope": "global",
      "extract": []
