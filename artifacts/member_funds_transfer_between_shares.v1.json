      "type": "string",
      "description": "Confirmation number issued for the posted transfer.",
      "sensitivity": "internal",
      "extraction": {
        "via": "fromLabelledCell",
        "label": "Confirmation:",
        "labelMatch": "normalized",
        "framePath": [],
        "direction": "right"
      },
      "transform": "trim",
      "required": true
    },
    {
