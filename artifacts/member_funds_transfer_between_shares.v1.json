      "sensitivity": "pii",
      "extraction": {
        "via": "regexOnPageText",
        "pattern": "\\(new balance\\)[\\s\\S]*?\\$([0-9,]+\\.[0-9]{2}) \\(new balance\\)",
        "group": 1
      },
      "transform": "stripCurrency",
      "required": true
    }
