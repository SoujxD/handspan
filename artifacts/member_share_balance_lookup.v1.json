{
  "schemaVersion": "1.0.0",
  "id": "member_share_balance_lookup",
  "version": 1,
  "name": "Member share balance, status and type lookup",
  "description": "Signs on to the Meridian Core servicing console with the supplied operator credentials, searches Member Inquiry by member number, opens the member record, and reads the Balance, Status and Type of one named share from the SHARES / BALANCES grid. Read-only: performs no transfer, hold, share opening or member update. Returns the share's current balance, status and share type, plus the member name. If the member number does not exist the console reports \"No member records matched your search.\" and no share values are returned.",
  "surface": {
    "kind": "legacy_web",
    "product": "cornerstone-meridian-core",
    "productVersion": "4.2.1",
    "recordedOnTenant": "meridian-demo",
    "entryUrl": "{{baseUrl}}/signon"
  },
  "inputs": [
    {
      "name": "operatorId",
      "type": "string",
      "description": "Operator sign-on id for the servicing console, e.g. teller1.",
      "required": true,
      "sensitivity": "internal",
      "example": "teller1"
    },
    {
      "name": "operatorPassword",
      "type": "string",
      "description": "Password for the operator id. Never logged or shown.",
      "required": true,
      "sensitivity": "secret"
    },
    {
      "name": "memberNumber",
      "type": "string",
      "description": "Member number to look up in Member Inquiry / Selection (Search by = Member Number).",
      "required": true,
      "sensitivity": "pii",
      "example": "100234"
    },
    {
      "name": "shareId",
      "type": "string",
      "description": "Exact share id as shown in the Share ID column of the SHARES / BALANCES grid, e.g. 100234-S0001. Must match the full id: the grid also contains longer ids that start with the same text.",
      "required": true,
      "sensitivity": "pii",
      "example": "100234-S0001"
    }
  ],
  "outputs": [
    {
      "name": "shareBalance",
      "type": "money",
      "description": "Current balance of the requested share, from the Balance column of its row in the SHARES / BALANCES grid.",
      "sensitivity": "pii",
      "extraction": {
        "via": "fromTableCell",
        "rowMatch": "100234-S0001",
        "columnLabel": "Balance",
        "matchMode": "contains",
        "framePath": []
      },
      "transform": "stripCurrency",
      "required": true
    },
    {
      "name": "shareStatus",
      "type": "string",
      "description": "Status of the requested share, from the Status column (e.g. OPEN, HOLD [HOLD]).",
      "sensitivity": "internal",
      "extraction": {
        "via": "fromTableCell",
        "rowMatch": "100234-S0001",
        "columnLabel": "Status",
        "matchMode": "contains",
        "framePath": []
      },
      "transform": "trim",
      "required": true
    },
    {
      "name": "shareType",
      "type": "string",
      "description": "Share type of the requested share, from the Type column (e.g. Regular Shares, Share Draft (Checking), Money Market, Certificate).",
      "sensitivity": "internal",
      "extraction": {
        "via": "fromTableCell",
        "rowMatch": "100234-S0001",
        "columnLabel": "Type",
        "matchMode": "contains",
        "framePath": []
      },
      "transform": "trim",
      "required": true
    },
    {
      "name": "memberName",
      "type": "string",
      "description": "Member name shown on the MEMBER RECORD panel, for confirming the correct record was opened.",
      "sensitivity": "pii",
      "extraction": {
        "via": "fromLabelledCell",
        "label": "Name:",
        "labelMatch": "normalized",
        "framePath": [],
        "direction": "right"
      },
      "transform": "trim",
      "required": true
    }
  ],
