          "role": "combobox",
          "nameMatch": "normalized",
          "label": "Search by:",
          "labelMatch": "normalized",
          "container": "MEMBER INQUIRY / SELECTION",
          "framePath": [],
          "hints": {
            "tag": "select"
          }
        },
        "value": {
          "from": "literal",
          "value": "Last Name"
        }
      },
      "risk": "safe",
      "retry": {
