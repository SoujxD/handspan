{
  "schemaVersion": "1.0.0",
  "id": "member_inquiry_by_last_name",
  "version": 3,
  "name": "Member Inquiry by Last Name",
  "description": "Signs on to the Meridian Core servicing console with the supplied operator credentials, opens Member Inquiry / Selection, searches by Last Name, and returns the matched member's member number and share count from the results table. If no member matches, reports a no_member_match business outcome.",
  "surface": {
    "kind": "legacy_web",
    "product": "cornerstone-meridian-core",
    "productVersion": "4.2.1",
    "recordedOnTenant": "meridian-demo",
    "entryUrl": "{{baseUrl}}/signon"
  },
  "inputs": [
    {
      "name": "operatorId",
      "type": "string",
      "description": "Operator ID used to sign on to the console.",
      "required": true,
      "sensitivity": "internal",
      "example": "teller1"
    },
    {
      "name": "operatorPassword",
      "type": "string",
      "description": "Password for the operator ID.",
      "required": true,
      "sensitivity": "secret"
    },
    {
      "name": "lastName",
      "type": "string",
      "description": "Member last name to search for.",
      "required": true,
      "sensitivity": "pii",
      "example": "Hopper"
    }
  ],
  "outputs": [
    {
      "name": "memberNumber",
      "type": "string",
      "description": "Member number of the first matched member in the results table.",
      "sensitivity": "internal",
      "extraction": {
        "via": "regexOnPageText",
        "pattern": "(\\d+)\\s+[^\\n]+,\\s*[^\\n]+?\\s+\\d+\\s*Select",
        "group": 1
      },
      "transform": "trim",
      "required": true
    },
    {
      "name": "shares",
      "type": "number",
      "description": "Number of shares shown for the matched member.",
      "sensitivity": "internal",
      "extraction": {
        "via": "regexOnPageText",
        "pattern": "\\d+\\s+[^\\n]+,\\s*[^\\n]+?\\s+(\\d+)\\s*Select",
        "group": 1
      },
      "transform": "trim",
      "required": true
    },
    {
      "name": "memberName",
      "type": "string",
      "description": "Displayed member name (Last, First) of the matched row.",
      "sensitivity": "pii",
      "extraction": {
        "via": "regexOnPageText",
        "pattern": "\\d+\\s+([A-Za-z'\\-]+,\\s*[A-Za-z'\\- ]+?)\\s+\\d+\\s*Select",
        "group": 1
      },
      "transform": "trim",
      "required": true
    }
  ],
  "steps": [
    {
      "id": "s01",
      "intent": "Enter the operator ID in the Operator ID box on the sign-on screen.",
      "act": {
        "action": "type",
        "target": {
          "description": "textbox labelled \"Operator ID:\" in the \"OPERATOR SIGN ON\" panel",
          "role": "textbox",
          "nameMatch": "normalized",
          "label": "Operator ID:",
          "labelMatch": "normalized",
          "container": "OPERATOR SIGN ON",
          "framePath": [],
          "hints": {
            "inputType": "text",
            "tag": "input"
          }
        },
        "value": {
          "from": "param",
          "name": "operatorId"
        },
        "clearFirst": true
      },
      "risk": "safe",
      "retry": {
        "attempts": 2,
        "backoffMs": 500
      }
    },
    {
      "id": "s02",
      "intent": "Enter the operator password in the Password box on the sign-on screen.",
      "act": {
        "action": "type",
        "target": {
          "description": "textbox labelled \"Password:\" in the \"OPERATOR SIGN ON\" panel",
          "role": "textbox",
          "nameMatch": "normalized",
          "label": "Password:",
          "labelMatch": "normalized",
          "container": "OPERATOR SIGN ON",
          "framePath": [],
          "hints": {
            "inputType": "password",
            "tag": "input"
          }
        },
        "value": {
          "from": "secret",
          "ref": "operatorPassword"
        },
        "clearFirst": true
      },
      "risk": "sensitive",
      "retry": {
        "attempts": 1,
        "backoffMs": 750
      }
    },
    {
      "id": "s03",
      "intent": "Sign on to the servicing console as the operator.",
      "act": {
        "action": "click",
        "target": {
          "description": "button \"Sign On\" in the \"OPERATOR SIGN ON\" panel",
          "role": "button",
          "name": "Sign On",
          "nameMatch": "normalized",
          "labelMatch": "normalized",
          "container": "OPERATOR SIGN ON",
          "framePath": [],
          "hints": {
            "inputType": "submit",
            "tag": "input"
          }
        }
      },
      "risk": "safe",
      "checkpoint": {
