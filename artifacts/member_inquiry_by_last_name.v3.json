        "backoffMs": 500
      }
    },
    {
      "id": "s06",
      "intent": "Enter the member's last name in the Value box.",
      "act": {
        "action": "type",
        "target": {
          "description": "textbox labelled \"Value:\" in the \"MEMBER INQUIRY / SELECTION\" panel",
          "role": "textbox",
          "nameMatch": "normalized",
          "label": "Value:",
          "labelMatch": "normalized",
          "container": "MEMBER INQUIRY / SELECTION",
          "framePath": [],
          "hints": {
            "inputType": "text",
            "tag": "input"
          }
        },
        "value": {
          "from": "secret",
          "ref": "lastName"
        },
        "clearFirst": true
      },
      "risk": "safe",
      "retry": {
        "attempts": 2,
        "backoffMs": 500
      }
    },
    {
      "id": "s07",
      "intent": "Run the member search by last name.",
      "act": {
        "action": "click",
        "target": {
          "description": "button \"Search\" in the \"MEMBER INQUIRY / SELECTION\" panel",
          "role": "button",
          "name": "Search",
          "nameMatch": "normalized",
          "labelMatch": "normalized",
          "container": "MEMBER INQUIRY / SELECTION",
          "framePath": [],
          "hints": {
            "inputType": "submit",
            "tag": "input"
          }
        }
      },
      "risk": "safe",
      "checkpoint": {
        "kind": "urlMatches",
        "pattern": "/members(?:[?#].*)?$"
      },
      "retry": {
        "attempts": 1,
        "backoffMs": 750
      }
    }
  ],
  "successCheckpoint": {
    "kind": "regexPresent",
    "pattern": "Member No\\.\\s*Name\\s*Shares"
  },
